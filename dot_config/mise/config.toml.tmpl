[settings]
auto_install = false
experimental = true
minimum_release_age = "3d"
exec_auto_install = false
not_found_auto_install = false

[tools]
# Not in dependencies
node = "lts"
"github:708u/twig" = "latest"
"github:bahdotsh/wrkflw" = "latest"
"github:coder3101/protols" = "latest"
"github:cordx56/rustowl" = "latest"
"github:terror/just-lsp" = "latest"
"github:trasta298/keifu" = "latest"
"github:ogulcancelik/herdr" = { version = "latest", os = ["linux", "macos"]}

# From dependencies
{{- $pref_cli := "mise" -}}
{{- if hasKey . "package_managers" -}}
  {{- $pref_cli = get .package_managers "cli" | default "mise" -}}
{{- else if hasKey . "preferred_installer" -}}
  {{- $pref_cli = get .preferred_installer "cli" | default "mise" -}}
{{- end -}}
{{- range $name, $managers := .dependencies.cli }}
{{- if hasKey $managers "mise" }}
{{- if or (eq $pref_cli "mise") (not (hasKey $managers $pref_cli)) }}
"{{ get $managers "mise" }}" = "latest"
{{- end }}
{{- end }}
{{- end }}
{{- $pref_dev := "mise" -}}
{{- if hasKey . "package_managers" -}}
  {{- $pref_dev = get .package_managers "dev" | default "mise" -}}
{{- else if hasKey . "preferred_installer" -}}
  {{- $pref_dev = get .preferred_installer "dev" | default "mise" -}}
{{- end -}}
{{- range $name, $managers := .dependencies.dev }}
{{- if hasKey $managers "mise" }}
{{- if or (eq $pref_dev "mise") (not (hasKey $managers $pref_dev)) }}
"{{ get $managers "mise" }}" = "latest"
{{- end }}
{{- end }}
{{- end }}


# Node.js based tools
{{- range .dependencies.npm }}
"npm:{{ . }}" = "latest"
{{- end }}
"npm:svelte-language-server" = { version = "latest", trust_policy_excludes = ["svelte@4.2.20"] }

# Python based tools
{{- range .dependencies.pip }}
"pipx:{{ . }}" = "latest"
{{- end }}
