# --- フォント & 外観 (Alacritty と完全同期) ---
font-family = "HackGen35 Console NF"
font-style = "Regular"
font-size = 11.25
freetype-load-flags = no-autohint
window-decoration = false
background = #0f0f0f
background-opacity = 0.7
background-blur = true
cursor-style = bar
cursor-style-blink = false
confirm-close-surface = false
gtk-single-instance = false

# --- シェル設定 ---
command = /home/user/.local/bin/xsh --login

# --- コピー＆ペースト (テキスト選択で自動コピー) ---
# テキスト選択時にセレクションバッファおよびシステムクリップボードへ自動コピー
copy-on-select = clipboard

# --- Zellij とのバッティングを完全回避 ---
# 1. Ghostty のデフォルトキーバインドを全解除 (タブやペインの横取りを防止)
keybind = clear

# 2. ターミナルとして必要な最小限のキーのみ登録
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = ctrl+shift+comma=reload_config
keybind = shift+enter=text:\x1b\r
