{{- if eq .chezmoi.os "windows" -}}
{{- $pref_cli := "scoop" -}}
{{- if hasKey . "package_manager" -}}
  {{- $pref_cli = .package_manager -}}
{{- else if hasKey . "package_managers" -}}
  {{- $pref_cli = get .package_managers "cli" | default "scoop" -}}
{{- else if hasKey . "preferred_installer" -}}
  {{- $pref_cli = get .preferred_installer "cli" | default "scoop" -}}
{{- end -}}

{{- $app_names := list -}}
{{- range $name, $managers := .dependencies.cli -}}
  {{- if hasKey $managers "scoop" -}}
    {{- if or (eq $pref_cli "scoop") (not (hasKey $managers "mise")) -}}
      {{- $app_names = append $app_names (get $managers "scoop") -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $apps := list -}}
{{- range ($app_names | uniq | sortAlpha) -}}
  {{- $apps = append $apps (dict "Name" . "Source" .) -}}
{{- end -}}

{{ dict "apps" $apps | toPrettyJson "  " }}
{{- end -}}
