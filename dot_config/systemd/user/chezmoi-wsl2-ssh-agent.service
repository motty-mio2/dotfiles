[Unit]
Description=WSL2 SSH Agent Bridge
After=network.target
ConditionUser=!root
ConditionPathExists=%h/.local/bin/wsl2-ssh-agent

[Service]
ExecStart=%h/.local/bin/wsl2-ssh-agent --foreground --socket=%t/wsl2-ssh-agent.sock
ExecStartPost=/usr/bin/systemctl --user set-environment SSH_AUTH_SOCK=%t/wsl2-ssh-agent.sock
ExecStopPost=-/usr/bin/systemctl --user unset-environment SSH_AUTH_SOCK
Restart=on-failure

[Install]
WantedBy=default.target
