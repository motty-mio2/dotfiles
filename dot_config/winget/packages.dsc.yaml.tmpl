{{- if eq .chezmoi.os "windows" -}}
# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
properties:
  configurationVersion: 0.2.0
  resources:
    # --- 基本システムツール ---
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: OpenSSH Preview Client
        allowPrerelease: true
      settings:
        id: Microsoft.OpenSSH.Preview
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: Microsoft PowerShell
        allowPrerelease: true
      settings:
        id: Microsoft.PowerShell
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: PowerToys
        allowPrerelease: true
      settings:
        id: XP89DCGQ3K6VLD
        source: msstore

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: Visual Studio Code
        allowPrerelease: true
      settings:
        id: Microsoft.VisualStudioCode
        source: winget

    # --- dependencies.desktop からの動的生成 ---
{{- range $name, $managers := .dependencies.desktop }}
{{- if hasKey $managers "winget" }}
{{- $id := get $managers "winget" }}
{{- $source := "winget" }}
{{- if not (contains "." $id) }}
{{- $source = "msstore" }}
{{- end }}
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: {{ $name }}
        allowPrerelease: true
      settings:
        id: {{ $id | quote }}
        source: {{ $source }}
{{- end }}
{{- end }}
{{- end -}}
