#!/usr/bin/env bash

{{ if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
export LD_LIBRARY_PATH=/usr/lib/wsl/lib:$LD_LIBRARY_PATH

open() {
	if [ $# != 1 ]; then
		explorer.exe .
	else
		if [ -e "$1" ]; then
			cmd.exe /c start "$(wslpath -w "$1")" 2>/dev/null

		else
			if [ -e "$1" ]; then
				cmd.exe /c start "$(wslpath -w "$1")" 2>/dev/null
			else
				echo "open: $1 : No such file or directory"
			fi
		fi
	fi
}

paste() {
	powershell.exe -command "[Console]::OutputEncoding = [System.Text.Encoding]::GetEncoding('utf-8');Get-Clipboard"
}

{{ 	if glob ( joinPath .chezmoi.homeDir "/.local/bin/wsl2-ssh-agent" ) }}
# ブリッジはログインセッション単位で chezmoi-wsl2-ssh-agent.service (systemd user unit)
# が管理し、固定パスのソケットで待ち受ける。
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/wsl2-ssh-agent.sock"
unset SSH_AGENT_PID
{{  end }}
{{ else if eq .chezmoi.os "linux" }}
# SSH エージェントはログインセッション単位で chezmoi-ssh-agent.service (systemd user unit)
# が管理し、固定パスのソケットで待ち受ける。シェルはそのパスを指定するだけで、
# 起動・終了はしない。子のログインシェル終了時に親のエージェントを殺さないため。
# ただしサーバ端末などで転送されたエージェント (ssh -A) が既に使える場合は尊重し、
# 未設定または接続できない場合だけ固定パスに切り替える。
if [ -z "$SSH_AUTH_SOCK" ] || ! ssh-add -l >/dev/null 2>&1; then
	export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket"
fi
unset SSH_AGENT_PID

# パスフレーズ入力で非対話シェルが止まらないよう、鍵の登録は対話シェル時のみ行う。
# 鍵が1つもない場合は何もしない。ssh-add に渡すのは秘密鍵だけにする。
if [ -t 0 ] && [ -t 1 ] && [ -S "$SSH_AUTH_SOCK" ] && ! ssh-add -l >/dev/null 2>&1; then
	for key in "$HOME"/.ssh/id_*; do
		case "$key" in
		*.pub) continue ;;
		esac
		[ -f "$key" ] || continue
		ssh-add "$key" 2>/dev/null
	done
fi
{{ end }}

if [ -n "$VSCODE_IPC_HOOK_CLI" ] && [ -x "${VSCODE_GIT_ASKPASS_NODE%/*}/bin/remote-cli/code" ]; then
	alias code='${VSCODE_GIT_ASKPASS_NODE%/*}/bin/remote-cli/code'
fi

# ロケール未生成環境での Perl 警告 (perl: warning: Setting locale failed.) を抑止
export PERL_BADLANG=0
