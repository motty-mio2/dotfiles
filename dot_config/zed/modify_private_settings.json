{{- /* chezmoi:modify-template */ -}}
{{- /* 現在の ~/.config/zed/settings.json (JSONC) が .chezmoi.stdin に渡される。管理する設定だけ上書きし、その他の既存設定 (ssh_connections など) は保持する。 */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $config = fromJsonc .chezmoi.stdin -}}
{{- end -}}
{{- /* Zed が MCP サーバーを起動するときは NPM_CONFIG_USERCONFIG が渡らず ~/.npm が作られるため、明示的に渡す。 */ -}}
{{- $managed := printf `
{
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "antigravity-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "git": {
    "git_gutter": "tracked_files",
    "path_style": "file_path_first",
    "branch_picker": {
      "show_author_name": false
    },
    "blame": {
      "show_avatar": false
    }
  },
  "git_panel": {
    "dock": "left",
    "sort_by_path": true,
  },
  "disable_ai": false,
  "vim_mode": false,
  "autosave": "on_focus_change",
  "auto_update": true,
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "enable_feedback": false,
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "One Dark",
  },
  "terminal": {
    "font_family": "HackGen35 Console NF",
    "shell": {
      "program": "zsh",
    },
    "working_directory": "current_project_directory",
  },
  "buffer_font_family": "HackGen35",
  "lsp": {},
  "languages": {
    "Python": {
      "format_on_save": "on",
    },
  },
  "context_servers": {
    "chrome-devtools": {
      "enabled": true,
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"],
      "env": {
        "NPM_CONFIG_USERCONFIG": %s
      },
    },
  },
}
` (printf "%s/.config/npm/npmrc" .chezmoi.homeDir | toJson) | fromJsonc -}}
{{ mergeOverwrite $config $managed | toPrettyJson }}
