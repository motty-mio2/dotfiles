{{- $targetFile := joinPath .chezmoi.homeDir ".gemini/antigravity-cli/settings.json" -}}
{{- $config := dict -}}
{{- if stat $targetFile -}}
  {{- $config = include $targetFile | fromJson -}}
{{- end -}}
{{- /* 初期値は、既存のキーがない場合だけ設定する。 */ -}}
{{- if not (hasKey $config "model") -}}
  {{- $_ := set $config "model" "Gemini 3.8 Flash (High)" -}}
{{- end -}}
{{- if not (hasKey $config "trustedWorkspaces") -}}
  {{- $_ := set $config "trustedWorkspaces" list -}}
{{- end -}}
{{- /* 管理する設定は、この JSON に追記する。その他の既存設定は保持する。 */ -}}
{{- $managed := printf `
{
  "allowNonWorkspaceAccess": true,
  "showFeedbackSurvey": false,
  "showTips": false,
  "statusLine": {
    "type": "command",
    "command": %s,
    "enabled": true
  }
}
` (printf "oh-my-posh antigravity --config %s/.config/ohmyposh/antigravity.omp.toml" .chezmoi.homeDir | toJson) | fromJson -}}
{{ mergeOverwrite $config $managed | toPrettyJson }}
