{{- $targetFile := joinPath .chezmoi.homeDir ".gemini/antigravity-cli/settings.json" -}}
{{- $state := dict "trusted" list "model" "Gemini 3.8 Flash (High)" -}}
{{- if stat $targetFile -}}
  {{- $current := include $targetFile | fromJson -}}
  {{- if hasKey $current "trustedWorkspaces" -}}
    {{- $_ := set $state "trusted" $current.trustedWorkspaces -}}
  {{- end -}}
  {{- if hasKey $current "model" -}}
    {{- $_ := set $state "model" $current.model -}}
  {{- end -}}
{{- end -}}
{
  "allowNonWorkspaceAccess": true,
  "enableTelemetry": false,
  "model": {{ $state.model | toJson }},
  "statusLine": {
    "type": "command",
    "command": "oh-my-posh antigravity --config {{ .chezmoi.homeDir }}/.config/ohmyposh/antigravity.omp.toml",
    "enabled": true
  },
  "trustedWorkspaces": {{ $state.trusted | toPrettyJson "  " | indent 2 | trim }}
}
