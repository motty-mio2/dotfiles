# Environement
{{- if lookPath "nvim" }}
export EDITOR=nvim
{{- else if lookPath "vim" }}
export EDITOR=vim
{{- end }}

for file in $(find "${HOME}/.config/shell" -name "*.sh"); do
    #shellcheck source=/dev/null
    source "${file}"
done

{{ if (lookPath "mise") }}
if command -v mise > /dev/null 2>&1; then
eval "$(mise activate {{ .shell }} --cd {{ .homeDir }})"
if [ -n "$(typeset -f mise 2>/dev/null)" ]; then
    eval "_orig_$(typeset -f mise)"
    mise() {
        if [ -z "$MISE_GITHUB_TOKEN" ]; then
            local token
            if token=$(gh auth token 2>/dev/null); then
                export MISE_GITHUB_TOKEN="$token"
            fi
        fi
        _orig_mise "$@"
    }
fi
fi
{{ end }}

{{ if lookPath "copilot" }}
copilot() {
    export COPILOT_OTEL_FILE_EXPORTER_PATH="$HOME/.copilot/otel/copilot-otel-$(date +%Y%m%d-%H%M%S).jsonl"
    command copilot "$@"
}
{{ end }}

# Shell Framework
{{  if and (lookPath "starship") }}
if command -v starship > /dev/null 2>&1; then
{{      output "starship" "init" .shell
        | replace (lookPath "starship") "starship"
}}
starship_precmd_user_func="set-window-title"
fi
{{  else }}
{{      if eq .shell "bash" }}
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
{{      else if eq .shell "zsh" }}
# POWERLEVEL
source "$XDG_CONFIG_HOME/zsh/plugins/powerlevel10k/powerlevel10k.zsh-theme"
POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
{{          include "dot_config/zsh/dot_p10k.zsh" }}
{{      end }}
{{ end }}

{{ if lookPath "zoxide" }}
if command -v zoxide > /dev/null 2>&1; then
{{      output "zoxide" "init" .shell }}
alias cd="z"
alias c="z"
alias cz="zi"
alias zode='code "$(zoxide query -i)"'
fi
{{ end }}
