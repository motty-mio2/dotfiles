# is_ai: AI エージェント環境か判定
is_ai() {
    [ -n "${CLAUDECODE:-}${CODEX_SANDBOX:-}${CURSOR_AGENT:-}${AI_AGENT:-}${OPENCODE:-}${AGY:-}${ORCA:-}${ORCA_AGENT_LAUNCH:-}${ORCA_AGENT_PANE:-}" ]
}

# 共通環境スクリプト (WSL, SSH agent 等)
if [ -f "${HOME}/.config/shell/env.sh" ]; then
    # shellcheck source=/dev/null
    source "${HOME}/.config/shell/env.sh"
fi

# mise (AI にも PATH を通すために必須)
{{ if (lookPath "mise") }}
if command -v mise > /dev/null 2>&1; then
eval "$(mise activate {{ .shell }} --cd {{ .homeDir }})"
if [ -n "$(typeset -f mise 2>/dev/null)" ]; then
    eval "_orig_$(typeset -f mise)"
    mise() {
        if [ -z "$MISE_GITHUB_TOKEN" ]; then
            local token
            if token=$(gh auth token 2>/dev/null); then
                export MISE_GITHUB_TOKEN="$token"
            fi
        fi
        _orig_mise "$@"
    }
fi
fi
{{ end }}

# 1. AI モード (AI エージェント実行時) の場合はハング防止用フェイルセーフを設定して早期リターン
if is_ai; then
    export EDITOR=true
    export VISUAL=true
    export GIT_EDITOR=true
    export GIT_SEQUENCE_EDITOR=true
    export PAGER=cat
    export GIT_PAGER=cat
    export MANPAGER=cat
    export GIT_TERMINAL_PROMPT=0

    return 0
fi

# 2. 通常の非対話シェル（スクリプト実行・GUI起動ラッパーなど）の場合はフェイルセーフを汚染させず早期リターン
if [ ! -t 0 ] || [ ! -t 1 ]; then
    return 0
fi
