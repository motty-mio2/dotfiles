{{- $targetFile := joinPath .chezmoi.homeDir ".claude/settings.json" -}}
{{- $config := dict -}}
{{- if stat $targetFile -}}
  {{- $config = include $targetFile | fromJson -}}
{{- end -}}
{{- /* 管理する設定は、この JSON に追記する。その他の既存設定は保持する。 */ -}}
{{- $managed := printf `
{
  "permissions": {
    "allow": []
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "liquid-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": %s
  }
}
` (printf "oh-my-posh claude --config %s/.config/ohmyposh/claude.omp.toml" .chezmoi.homeDir | toJson) | fromJson -}}
{{ mergeOverwrite $config $managed | toPrettyJson }}
