{{- /* chezmoi:modify-template */ -}}
{{- /* 現在の ~/.claude/settings.json が .chezmoi.stdin に渡される。管理する設定だけ上書きし、その他の既存設定は保持する。 */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $managed := printf `
{
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "liquid-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": []
  },
  "statusLine": {
    "type": "command",
    "command": %s
  },
  "theme": "dark"
}
` (printf "oh-my-posh claude --config %s/.config/ohmyposh/claude.omp.toml" .chezmoi.homeDir | toJson) | fromJson -}}
{{ mergeOverwrite $config $managed | toPrettyJson }}
