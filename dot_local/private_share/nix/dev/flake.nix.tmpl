{
  description = "A very basic flake";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs?ref=nixos-{{- .dependencies.nix }}";
    flake-utils.url = "github:numtide/flake-utils";
  };

  outputs =
    { self, nixpkgs, flake-utils }:
    flake-utils.lib.eachDefaultSystem(
      system:
      let
        pkgs = nixpkgs.legacyPackages.${system};
      in
      {
        packages.dev = pkgs.buildEnv {
          name = "dev";
          paths = with pkgs; [
            {{- $pref := "nix" -}}
            {{- if hasKey . "package_managers" -}}
              {{- $pref = get .package_managers "dev" | default "nix" -}}
            {{- else if hasKey . "preferred_installer" -}}
              {{- $pref = get .preferred_installer "dev" | default "nix" -}}
            {{- end -}}
            {{- range $name, $managers := .dependencies.dev -}}
              {{- if hasKey $managers "nix" -}}
                {{- if or (eq $pref "nix") (not (lookPath "mise")) (not (hasKey $managers "mise")) -}}
                  {{- get $managers "nix" | printf "%s " -}}
                {{- end -}}
              {{- end -}}
            {{- end }}
          ];
        };
      }
    );
}
